{
  "name": "ciclo-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create ciclo-db",
    "db:migrate": "wrangler d1 migrations apply ciclo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ciclo-db --remote",
    "db:seed": "wrangler d1 execute ciclo-db --local --file=./migrations/9999_seed_dev.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.91.0"
  }
}
