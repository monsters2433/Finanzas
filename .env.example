# ── Acceso a la app ────────────────────────────────────────────────────────────
# Contraseña única. Déjala vacía solo si la app nunca sale de tu equipo.
APP_PASSWORD=
# Cambia esto y todas las sesiones abiertas caducan.
AUTH_SALT=finanzas-v1
# URL pública de la app. Necesaria para el callback del banco y el feed de calendario.
APP_URL=http://localhost:3000

# ── Banco (PSD2) ───────────────────────────────────────────────────────────────
# Regístrate gratis en https://bankaccountdata.gocardless.com y crea un par de claves.
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# ── Notificaciones push ────────────────────────────────────────────────────────
# Genera el par con: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com

# ── Automatización ─────────────────────────────────────────────────────────────
# Secreto que debe enviar el cron / n8n para invocar /api/cron.
CRON_SECRET=

# ── Almacenamiento ─────────────────────────────────────────────────────────────
# DATABASE_PATH=/ruta/absoluta/finanzas.db
